<% layout("/layouts/boilerplate") %>
<style>
     @media (max-width: 768px) {
        .index-container {
            justify-content: center;
        }

        .index-card {
            width: 100% !important;
            max-width: 22rem;
            margin-right: 1rem !important;
        }
    }
    @media (min-width: 769px) and (max-width: 1200px) {
        .index-container {
            justify-content: center;
            max-width: 100%;
        }

        .index-card {
            width: 20rem !important;
            margin-right: 1rem !important;
        }
    }
    .iconbar{
        /* border-bottom:1px solid black; */
        padding: .5rem;
        margin-bottom: .25rem;
    }
    .nav-link{
        color: black;
    }
    .form-switch {
        display: flex;
        align-items: center;
       
    }
    .form-switch .form-check-input {
    width: 3rem;
    height: 1.5rem;
    cursor: pointer;
}

.form-switch .form-check-input:checked {
    background-color: #fe424d;
    border-color: #fe424d;
}

.form-switch .form-check-input:focus {
    box-shadow: 0 0 5px rgba(254, 66, 77, 0.4);
}
</style>
   <!-- icon bar -->
<div class="nav-overflow iconbar" data-bs-toggle="nav-overflow">
  <ul class="nav nav-pills">
    <li class="nav-item">
      <a class="nav-link" href="#">Home</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="#">Dashboard</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="#">Products</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="#">Services</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="#">Analytics</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="#">Reports</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="#">Settings</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="#">Help</a>
    </li>
 <li class="nav-item ms-auto">
  <div class="form-check form-switch ms-3">
    
    <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="taxSwitch">
        
    <label class="form-check-label" for="taxSwitch">
        Display Taxes
    </label>

  </div>
 </li>
 </ul>
</div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 index-container">
        <% for (let listing of listings) { %>
           <a href="/listings/<%= listing._id %>">
               <div class="card col index-card" style="width: 25rem">
                 
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">
                  
                    <div class="card-body">   
                  
                      <h4><%= listing.title %></h4>
                      <p class="listing-price"
   data-price="<%= listing.price || 0 %>">

    ₹<%= listing.price
        ? listing.price.toLocaleString("en-IN")
        : "N/A" %>
    <span class="tax-text"> + 10% taxes</span>
</p>
                      <!-- <p>Price: &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></p> -->
                    </div>
                </div>
            </a>
        <% } %>
     </div>